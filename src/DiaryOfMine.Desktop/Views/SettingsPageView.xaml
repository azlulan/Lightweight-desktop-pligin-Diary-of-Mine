<UserControl x:Class="DiaryOfMine.Desktop.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CED3CF" />
        </Style>
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="本地文件" FontSize="18" FontWeight="SemiBold" />
            <Border Background="White"
                    BorderBrush="#E5E7E3"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,12,0,24">
                <StackPanel>
                    <TextBlock Text="应用配置目录" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UserDataRoot}"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="保存本机应用偏好设置。"
                               Margin="0,4,0,18"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <TextBlock Text="用户数据缓存位置" FontWeight="SemiBold" />
                    <Grid Margin="0,7,0,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CacheDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Style="{StaticResource BrowseButtonStyle}"
                                Command="{Binding BrowseCacheDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="用户内容统一写入此目录下的文件。更换设备时复制该文件并选择其所在目录即可加载。"
                               Margin="0,-10,0,10"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <Border Margin="0,0,0,18" Padding="12,10" CornerRadius="7"
                            Background="#FFF8F7" BorderBrush="#F0D7D3" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="清空个人日程" FontWeight="SemiBold" Foreground="#8D433E" />
                                <TextBlock Text="重置本机的 Class等日程和工作记录，不影响设置与日志。"
                                           Margin="0,3,12,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="清空日程"
                                    MinWidth="88" Padding="12,6"
                                    Foreground="#A43F38" Background="White"
                                    BorderBrush="#DFA9A4"
                                    Command="{Binding ClearCalendarCommand}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="日志输出位置" FontWeight="SemiBold" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="浏览…"
                                Style="{StaticResource BrowseButtonStyle}"
                                Command="{Binding BrowseLogDirectoryCommand}" />
                        <Button Grid.Column="2"
                                Content="打开文件夹位置"
                                Style="{StaticResource BrowseButtonStyle}"
                                Command="{Binding OpenLogDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="日志用于处理报错，软件出错时请将此文件发送至开发人员邮箱：haotian170993@163.com。"
                               Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="日程外观" FontSize="18" FontWeight="SemiBold" />
            <Border Background="White"
                    BorderBrush="#E5E7E3"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,12,0,24">
                <StackPanel>
                    <TextBlock Text="工作色块使用独立色板。搭配个人喜好点击保存，系统会随机选择色块进行绘制。"
                               Margin="0,0,0,16"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Class 色板" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="6" Rows="1" Margin="0,0,0,16">
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickClassPaletteColor1Command}" Background="{Binding ClassPaletteColor1}" ToolTip="Class 色槽 1" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickClassPaletteColor2Command}" Background="{Binding ClassPaletteColor2}" ToolTip="Class 色槽 2" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickClassPaletteColor3Command}" Background="{Binding ClassPaletteColor3}" ToolTip="Class 色槽 3" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickClassPaletteColor4Command}" Background="{Binding ClassPaletteColor4}" ToolTip="Class 色槽 4" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickClassPaletteColor5Command}" Background="{Binding ClassPaletteColor5}" ToolTip="Class 色槽 5" />
                        <Button Height="38" Command="{Binding PickClassPaletteColor6Command}" Background="{Binding ClassPaletteColor6}" ToolTip="Class 色槽 6" />
                    </UniformGrid>
                    <TextBlock Text="Key 色板" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="6" Rows="1" Margin="0,0,0,16">
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickKeyPaletteColor1Command}" Background="{Binding KeyPaletteColor1}" ToolTip="Key 色槽 1" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickKeyPaletteColor2Command}" Background="{Binding KeyPaletteColor2}" ToolTip="Key 色槽 2" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickKeyPaletteColor3Command}" Background="{Binding KeyPaletteColor3}" ToolTip="Key 色槽 3" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickKeyPaletteColor4Command}" Background="{Binding KeyPaletteColor4}" ToolTip="Key 色槽 4" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickKeyPaletteColor5Command}" Background="{Binding KeyPaletteColor5}" ToolTip="Key 色槽 5" />
                        <Button Height="38" Command="{Binding PickKeyPaletteColor6Command}" Background="{Binding KeyPaletteColor6}" ToolTip="Key 色槽 6" />
                    </UniformGrid>
                    <TextBlock Text="工作模式色板" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="6" Rows="1">
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickWorkPaletteColor1Command}" Background="{Binding WorkPaletteColor1}" ToolTip="工作色槽 1" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickWorkPaletteColor2Command}" Background="{Binding WorkPaletteColor2}" ToolTip="工作色槽 2" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickWorkPaletteColor3Command}" Background="{Binding WorkPaletteColor3}" ToolTip="工作色槽 3" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickWorkPaletteColor4Command}" Background="{Binding WorkPaletteColor4}" ToolTip="工作色槽 4" />
                        <Button Margin="0,0,8,0" Height="38" Command="{Binding PickWorkPaletteColor5Command}" Background="{Binding WorkPaletteColor5}" ToolTip="工作色槽 5" />
                        <Button Height="38" Command="{Binding PickWorkPaletteColor6Command}" Background="{Binding WorkPaletteColor6}" ToolTip="工作色槽 6" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="通知" FontSize="18" FontWeight="SemiBold" />
            <Border Background="White"
                    BorderBrush="#E5E7E3"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,12,0,24">
                <StackPanel>
                    <CheckBox IsChecked="{Binding EnableNotifications}"
                              Content="启用通知"
                              FontWeight="SemiBold" />
                    <TextBlock Text="提醒窗需逐项确认才会消失，提示时播放提示音。"
                               Margin="24,7,0,16"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel Margin="24,0,0,0"
                                IsEnabled="{Binding EnableNotifications}">
                        <CheckBox IsChecked="{Binding EnableClassNotifications}"
                                  Content="Class（日程截止前 30 分钟）" />
                        <CheckBox IsChecked="{Binding EnableKeyNotifications}"
                                  Content=" Key （日程开始前 30 分钟）"
                                  Margin="0,10,0,0" />
                        <CheckBox IsChecked="{Binding EnableIdeaNotifications}"
                                  Content="Idea：该日 23:30 提醒未完成项目"
                                  Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="窗口行为" FontSize="18" FontWeight="SemiBold" />
            <Border Background="White"
                    BorderBrush="#E5E7E3"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22"
                    Margin="0,12,0,18">
                <StackPanel>
                    <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              Content="开机自启软件"
                              FontWeight="SemiBold" />
                    <TextBlock Text="无需管理员权限运行；自启时直接进入悬浮模式。"
                               Margin="24,7,0,20" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <TextBlock Text="悬浮模式全局展开快捷键" FontWeight="SemiBold" />
                    <Grid Margin="0,7,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExpandHotKeyTextBox"
                                 Text="{Binding ExpandHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 PreviewKeyDown="OnExpandHotKeyPreviewKeyDown"
                                 ToolTip="点击后直接按下单键，或修饰键 + 普通键" />
                        <Button Grid.Column="1" Content="恢复默认"
                                Style="{StaticResource BrowseButtonStyle}"
                                Click="OnResetExpandHotKeyClick" />
                    </Grid>
                    <TextBlock Text="支持单键或双键组合（Ctrl / Alt / Shift / Win + 普通键） 快捷键为全局按键，仅在悬浮模式下执行展开。"
                               Margin="0,0,0,20" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <CheckBox IsChecked="{Binding AutoFloatAndSleepWhenInactive, Mode=TwoWay}"
                              Content="主窗口消失或切换到软件外时，自动进入悬浮休眠"
                              FontWeight="SemiBold" />
                    <TextBlock Text="开启后，失焦、最小化和关闭主窗口都会显示悬浮窗；编辑器、详情窗、文件选择和拖拽操作期间保持原窗口。关闭此项后，最小化保留任务栏，关闭主窗口隐藏到托盘。"
                               Margin="24,7,0,20"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <CheckBox IsChecked="{Binding PinFloatingWindow, Mode=TwoWay}"
                              Content="固定悬浮窗位置并保持置顶"
                              FontWeight="SemiBold" />
                    <TextBlock Text="置顶适用于普通窗口和多数无边框全屏程序；独占全屏游戏可能阻止其他窗口显示。"
                               Margin="24,7,0,14"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" />

                    <Grid Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FloatingWindowLeft, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   Text="Y"
                                   VerticalAlignment="Center"
                                   Margin="18,0,8,0" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding FloatingWindowTop, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Text="悬浮窗模式直接拖动悬浮窗即可快速调整位置。"
                               Margin="24,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Content="保存设置"
                        Command="{Binding SaveCommand}"
                        Padding="18,8"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
