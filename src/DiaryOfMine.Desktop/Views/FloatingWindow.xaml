<Window x:Class="DiaryOfMine.Desktop.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diary of Mine — Quick Entry"
        Icon="../Assets/DiaryOfMine.ico"
        Width="326" Height="58"
        MinWidth="326" MinHeight="58"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Background="#F7F8F5"
            BorderBrush="#CDD5CF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8"
            MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="5,0,8,0">
                <TextBlock Text="Diary of Mine" FontWeight="SemiBold" />
                <TextBlock x:Name="FloatingStatusText" Text="休眠模式" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="CalendarMenuButton" Width="28" Height="28" Margin="2"
                        ToolTip="日程表 · 添加 Class、Key、Task 或 Idea" Click="OnCalendarMenuClick">
                    <Image Source="{StaticResource ClassIcon}" Width="16" Height="16" />
                </Button>
                <Button x:Name="WorkRecordButton" Width="28" Height="28" Margin="2"
                        ToolTip="工作模式 · 录制" Click="OnWorkRecordClick">
                    <Grid>
                        <Ellipse Width="16" Height="16" Stroke="#52635B" StrokeThickness="1.5" />
                        <Ellipse Width="7" Height="7" Fill="#5C9A80" />
                    </Grid>
                </Button>
                <Button Width="28" Height="28" Margin="2" ToolTip="打开设置" Click="OnSettingsClick">
                    <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="19" FontWeight="SemiBold"
                               Foreground="#52635B" Margin="0,-1,0,0" />
                </Button>
            </StackPanel>
            <Button x:Name="ExpandButton" Grid.Column="2"
                    Content="展开"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Click="OnRestoreClick" />

            <Popup x:Name="CalendarPanelPopup" PlacementTarget="{Binding ElementName=CalendarMenuButton}"
                   Placement="Bottom" PopupAnimation="Slide" AllowsTransparency="True" StaysOpen="False">
                <Border Margin="0,7,0,0" Padding="7" Background="#F7F8F5" BorderBrush="#CDD5CF"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="34" Height="34" Margin="2" ToolTip="添加 Class" Click="OnClassClick">
                            <Image Source="{StaticResource ClassIcon}" Width="18" Height="18" />
                        </Button>
                        <Button Width="34" Height="34" Margin="2" ToolTip="添加 Key" Click="OnKeyClick">
                            <Image Source="{StaticResource KeyIcon}" Width="18" Height="18" />
                        </Button>
                        <Button Width="34" Height="34" Margin="2" ToolTip="添加 Idea" Click="OnIdeaClick">
                            <Image Source="{StaticResource IdeaIcon}" Width="18" Height="18" />
                        </Button>
                        <Button Width="34" Height="34" Margin="2" ToolTip="Task · 批量添加 Key" Click="OnTaskClick">
                            <Image Source="{StaticResource TaskIcon}" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="WorkPanelPopup" PlacementTarget="{Binding ElementName=WorkRecordButton}"
                   Placement="Bottom" PopupAnimation="Slide" AllowsTransparency="True" StaysOpen="False">
                <Border Margin="0,7,0,0" Width="176" Padding="9" Background="#F7F8F5"
                        BorderBrush="#CDD5CF" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="选择工作目标" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#52635B" Margin="4,1,4,6" />
                        <ScrollViewer MaxHeight="178" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="WorkGoalsPanel" />
                        </ScrollViewer>
                        <TextBlock x:Name="WorkPanelStatusText" Visibility="Collapsed" FontSize="10.5"
                                   Foreground="#7A847E" Margin="4,6,4,2" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
