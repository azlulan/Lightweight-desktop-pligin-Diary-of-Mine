<UserControl x:Class="DiaryOfMine.Desktop.Views.WorkModePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#F3F6F3" />
            <Setter Property="Foreground" Value="#365044" />
            <Setter Property="BorderBrush" Value="#D9E1DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.84" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="#FAFCFA" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAFAF8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Background="#F6F8F5" BorderBrush="#E0E5E0" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="‹" Width="39" Padding="0" Style="{StaticResource RoundedButton}"
                        Command="{Binding PreviousDayCommand}" ToolTip="前一天" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="JumpDateButton" Margin="10,0,0,0" Width="38" Height="38" Padding="0"
                            Background="Transparent" BorderThickness="0" Style="{StaticResource RoundedButton}"
                            Click="OnJumpDateClick" ToolTip="选择日期">
                        <TextBlock Text="▦" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="#52635B" />
                    </Button>
                    <Border x:Name="RecordingBadge" Visibility="Collapsed" Margin="12,0,0,0"
                            Height="34" Background="#E4F1E9" BorderBrush="#BFD8C8" BorderThickness="1"
                            CornerRadius="11" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#5C9A80" Margin="0,0,7,0" />
                            <TextBlock x:Name="RecordingBadgeText" Text="录制中" FontWeight="SemiBold"
                                       Foreground="#416B58" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button Grid.Column="2" Content="›" Width="39" Padding="0" Style="{StaticResource RoundedButton}"
                        Command="{Binding NextDayCommand}" ToolTip="后一天" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="248" /></Grid.ColumnDefinitions>

            <Border x:Name="TimelineHost" Background="White" BorderBrush="#DFE4DF" BorderThickness="1"
                    CornerRadius="15" Padding="12" ClipToBounds="True" SizeChanged="OnTimelineSizeChanged">
                <Grid>
                    <ScrollViewer x:Name="TimelineScroller" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" PanningMode="None"
                                  PreviewMouseWheel="OnTimelineMouseWheel"
                                  PreviewMouseDown="OnTimelineMouseDown"
                                  PreviewMouseMove="OnTimelineMouseMove"
                                  PreviewMouseUp="OnTimelineMouseUp">
                        <Grid x:Name="TimelineSurface" MinWidth="560">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Margin="0,0,0,6" Background="#FBFCFA" BorderBrush="#E7EBE7" BorderThickness="1" CornerRadius="12">
                                <Canvas x:Name="TopCanvas" MinHeight="170" ClipToBounds="True" />
                            </Border>
                            <Border Grid.Row="1" Margin="0,6,0,0" Background="#FBFCFA" BorderBrush="#E7EBE7" BorderThickness="1" CornerRadius="12">
                                <Canvas x:Name="BottomCanvas" MinHeight="170" ClipToBounds="True" />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,24"
                            Background="#E9EFEA" CornerRadius="9" Padding="9,5" IsHitTestVisible="False">
                        <TextBlock FontSize="10.5" Foreground="#68766E"
                                   Text="滚轮缩放 · 中键拖动画布 · 中键单击恢复 · 双击色块修改目标" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#DFE4DF" BorderThickness="1" CornerRadius="15" Padding="11">
                    <StackPanel>
                        <DockPanel Margin="4,1,4,7">
                            <TextBlock Text="工作工具" FontWeight="SemiBold" FontSize="15" />
                            <Button DockPanel.Dock="Right" Content="今天" Height="28" Padding="10,0"
                                    Style="{StaticResource RoundedButton}" Command="{Binding TodayCommand}" />
                        </DockPanel>
                        <UniformGrid Columns="2" Rows="2">
                            <Button Style="{StaticResource ToolButton}" Click="OnAddClick" ToolTip="管理工作目标">
                                <StackPanel><TextBlock Text="＋" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Add" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="InterruptButton" Style="{StaticResource ToolButton}" Click="OnInterruptClick" ToolTip="开始或结束中断区块">
                                <StackPanel><TextBlock Text="◐" FontSize="22" HorizontalAlignment="Center" Foreground="#C77A7A" /><TextBlock Text="Interrupt" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="TranscribeButton" Style="{StaticResource ToolButton}" Click="OnTranscribeClick" ToolTip="选择目标并开始录制">
                                <StackPanel><TextBlock Text="●" FontSize="21" HorizontalAlignment="Center" Foreground="#5C9A80" /><TextBlock Text="Transcribe" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="FinishButton" Style="{StaticResource ToolButton}" Click="OnFinishClick" ToolTip="结束当前录制">
                                <StackPanel><TextBlock Text="■" FontSize="18" HorizontalAlignment="Center" Foreground="#62736A" /><TextBlock Text="Finish" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="White" BorderBrush="#DFE4DF" BorderThickness="1" CornerRadius="15" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="时长统计" FontWeight="SemiBold" FontSize="15" />
                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <UniformGrid Columns="2">
                                <Button x:Name="TodayStatsButton" Content="今日" Margin="0,0,4,0" Height="30" Style="{StaticResource RoundedButton}" Click="OnTodayStatsClick" />
                                <Button x:Name="AllStatsButton" Content="累计" Margin="4,0,0,0" Height="30" Style="{StaticResource RoundedButton}" Click="OnAllStatsClick" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,7,0,0">
                                <Button x:Name="DurationSortButton" Content="按时长" Margin="0,0,4,0" Height="27" Style="{StaticResource RoundedButton}" Click="OnDurationSortClick" />
                                <Button x:Name="NameSortButton" Content="按名称" Margin="4,0,0,0" Height="27" Style="{StaticResource RoundedButton}" Click="OnNameSortClick" />
                            </UniformGrid>
                        </StackPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="StatsPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="19,4,12,0"
                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

        <Popup x:Name="GoalPopup" PlacementTarget="{Binding ElementName=TranscribeButton}"
               Placement="Left" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#D9E1DB" BorderThickness="1" CornerRadius="14" Padding="12" Width="190">
                <StackPanel>
                    <TextBlock x:Name="GoalPopupTitle" Text="选择工作目标" FontWeight="SemiBold" Margin="3,0,3,8" />
                    <StackPanel x:Name="GoalsPanel" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=JumpDateButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#D9E1DB" BorderThickness="1" CornerRadius="14" Padding="8">
                <Calendar x:Name="JumpCalendar" SelectedDatesChanged="OnJumpCalendarSelected" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
