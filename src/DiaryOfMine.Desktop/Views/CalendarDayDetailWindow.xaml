<Window x:Class="DiaryOfMine.Desktop.Views.CalendarDayDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="详细日程表"
        Icon="../Assets/DiaryOfMine.ico"
        Width="1160" Height="760"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAF8"
        FontFamily="Microsoft YaHei UI"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="DetailButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#F7F9F7" />
            <Setter Property="Foreground" Value="#34423B" />
            <Setter Property="BorderBrush" Value="#D5DDD8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#EAF0EC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DetailButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style x:Key="KindButtonStyle" TargetType="Button" BasedOn="{StaticResource DetailButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Background="#F5F7F4" BorderBrush="#DDE4DF" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="返回月历" Style="{StaticResource DetailButtonStyle}"
                        VerticalAlignment="Center" Click="OnReturnToCalendarClick" />

                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="‹" FontSize="20" ToolTip="前一天" Margin="0,0,12,0"
                            Style="{StaticResource DetailIconButtonStyle}" Click="OnPreviousDayClick" />
                    <StackPanel Grid.Column="1" MinWidth="210" VerticalAlignment="Center">
                        <TextBlock x:Name="DateHeading" FontSize="19" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="DateSubtitle" Margin="0,3,0,0" FontSize="10.5"
                                   Foreground="#748078" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="›" FontSize="20" ToolTip="后一天" Margin="12,0,0,0"
                            Style="{StaticResource DetailIconButtonStyle}" Click="OnNextDayClick" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="转到今天" Style="{StaticResource DetailButtonStyle}"
                            Margin="0,0,9,0" Click="OnTodayClick" />
                    <Button ToolTip="添加 Class" Style="{StaticResource KindButtonStyle}"
                            Margin="0,0,5,0" Click="OnAddClassClick">
                        <Image Source="{StaticResource ClassIcon}" Width="18" Height="18" />
                    </Button>
                    <Button ToolTip="添加 Key" Style="{StaticResource KindButtonStyle}"
                            Margin="0,0,5,0" Click="OnAddKeyClick">
                        <Image Source="{StaticResource KeyIcon}" Width="18" Height="18" />
                    </Button>
                    <Button ToolTip="添加 Idea" Style="{StaticResource KindButtonStyle}"
                            Margin="0,0,5,0" Click="OnAddIdeaClick">
                        <Image Source="{StaticResource IdeaIcon}" Width="18" Height="18" />
                    </Button>
                    <Button ToolTip="Task · 批量添加 Key" Style="{StaticResource KindButtonStyle}"
                            Margin="0,0,9,0" Click="OnAddTaskClick">
                        <Image Source="{StaticResource TaskIcon}" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="UndoButton" ToolTip="撤回（仅详细日程表）"
                            Style="{StaticResource DetailIconButtonStyle}" Margin="0,0,5,0"
                            Click="OnUndoClick" Cursor="Hand">
                        <Image Source="{StaticResource UndoIcon}" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="RedoButton" ToolTip="重做（仅详细日程表）"
                            Style="{StaticResource DetailIconButtonStyle}" Click="OnRedoClick">
                        <Image Source="{StaticResource RedoIcon}" Width="18" Height="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="570" />
                <ColumnDefinition Width="272" />
            </Grid.ColumnDefinitions>

            <Border Margin="16,14,10,12" Background="White" BorderBrush="#DCE3DE"
                    BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                <ScrollViewer x:Name="TimelineScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              PreviewMouseWheel="OnTimelineMouseWheel"
                              PreviewMouseDown="OnTimelineMouseDown"
                              PreviewMouseMove="OnTimelineMouseMove"
                              PreviewMouseUp="OnTimelineMouseUp"
                              SizeChanged="OnTimelineSizeChanged">
                    <StackPanel x:Name="TimelineRowsPanel" Margin="10" />
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Margin="0,14,16,12" Background="#F7F8F4"
                    BorderBrush="#DCE3DE" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="1.1*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="0.9*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="15,0">
                        <TextBlock Text="IDEA" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="IdeaCountText" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="#748078" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="IdeaPanel" Margin="12,0,12,14" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#DCE3DE" />

                    <Grid Grid.Row="3" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="灵感" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="InspirationCountText" FontSize="10.5"
                                       Foreground="#748078" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ 灵感" Style="{StaticResource DetailButtonStyle}"
                                    Height="30" Padding="8,0" Margin="0,0,5,0"
                                    Click="OnAddInspirationClick" />
                            <Button Content="+ 日记" Style="{StaticResource DetailButtonStyle}"
                                    Height="30" Padding="8,0" Click="OnOpenDiaryClick"
                                    ToolTip="打开当天日记" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="InspirationPanel" Margin="12,0,12,14" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F5F7F4" BorderBrush="#DDE4DF"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock Text="滚轮缩放          中键拖动画布              单击中键恢复               Shift + 左键切换完成状态               Shift + 滚轮查看隐藏项目               双击编辑               拖动端点修改时间               将色块或便签甩出边界删除"
                           VerticalAlignment="Center" FontSize="10" Foreground="#748078"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Border x:Name="InteractionStatus" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="#FFF8ED"
                        BorderBrush="#E5D3B6" BorderThickness="1" CornerRadius="7"
                        Padding="9,3" Visibility="Collapsed">
                    <TextBlock x:Name="InteractionStatusText" FontSize="10.5" />
                </Border>
            </Grid>
        </Border>

        <Popup x:Name="FileLinksPopup" AllowsTransparency="True" StaysOpen="True"
               Placement="Bottom" HorizontalOffset="8" VerticalOffset="4"
               PopupAnimation="Fade">
            <Border x:Name="FileLinksPopupRoot" Width="372" MaxHeight="350"
                    Background="#FBFCFA" BorderBrush="#C9D5CE" BorderThickness="1"
                    CornerRadius="12" Padding="14"
                    AllowDrop="True" DragOver="OnPopupFileLinksDragOver" Drop="OnPopupFileLinksDrop"
                    MouseEnter="OnFileLinksPopupMouseEnter" MouseLeave="OnFileLinksPopupMouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="快速链接" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#34423B" VerticalAlignment="Center" />
                        <TextBlock x:Name="FileLinksPopupCountText" HorizontalAlignment="Right"
                                   Foreground="#748078" FontSize="10.5" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="238" Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FileLinksPopupItems" />
                    </ScrollViewer>
                    <TextBlock x:Name="FileLinksPopupStatusText" Grid.Row="2" Margin="0,8,0,0"
                               Foreground="#956C44" FontSize="10.5" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <Grid Grid.Row="3" Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="拖入文件/文件夹 · 仅保存地址"
                                   FontSize="10" Foreground="#8A948E" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="8,0,0,0">
                            <Button Content="+ 文件" Style="{StaticResource DetailButtonStyle}"
                                    Height="30" Padding="8,0" Margin="0,0,5,0"
                                    Click="OnPopupAddFilesClick" />
                            <Button Content="+ 文件夹" Style="{StaticResource DetailButtonStyle}"
                                    Height="30" Padding="8,0" Click="OnPopupAddFoldersClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
