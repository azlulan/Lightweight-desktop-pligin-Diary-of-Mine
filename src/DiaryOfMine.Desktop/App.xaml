<Application x:Class="DiaryOfMine.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DiaryOfMine.Desktop.ViewModels"
             xmlns:views="clr-namespace:DiaryOfMine.Desktop.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3D6B57" />
        <SolidColorBrush x:Key="TextBrush" Color="#202823" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#68726C" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#F2F3EF" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#E1E9E3" />

        <DrawingImage x:Key="ClassIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M 3,5 L 17,5 M 3,10 L 13,10 M 3,15 L 16,15">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#52635B" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="KeyIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M 10,8 A 4,4 0 1 1 6,4 A 4,4 0 0 1 10,8 M 9,9 L 17,17 M 14.5,14.5 L 17,12 M 12.5,12.5 L 15,10">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#52635B" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IdeaIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M 7,15 L 13,15 M 8,18 L 12,18 M 10,2 A 6,6 0 0 0 6.2,12.6 C 7,13.2 7.3,13.7 7.4,15 L 12.6,15 C 12.7,13.7 13,13.2 13.8,12.6 A 6,6 0 0 0 10,2">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#52635B" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M 4,4 L 16,4 L 16,17 L 4,17 Z M 7,2 L 7,6 M 13,2 L 13,6 M 7,9 L 13,9 M 7,12 L 11,12 M 13,13 L 16,16 M 16,13 L 13,16">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#52635B" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="UndoIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M 8,5 L 3,9 L 8,13 M 4,9 L 11.5,9 C 15.5,9 17,11.4 17,15">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#52635B" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="RedoIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M 12,5 L 17,9 L 12,13 M 16,9 L 8.5,9 C 4.5,9 3,11.4 3,15">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#52635B" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DataTemplate DataType="{x:Type viewModels:HomePageViewModel}">
            <views:HomePageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LinksPageViewModel}">
            <views:LinksPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:WorkModePageViewModel}">
            <views:WorkModePageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsPageViewModel}">
            <views:SettingsPageView />
        </DataTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#E8EAE6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="BackgroundBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
