<Window x:Class="DiaryOfMine.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diary of Mine"
        Icon="Assets/DiaryOfMine.ico"
        Width="1040" Height="700"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="True"
        Closing="OnClosing"
        SizeChanged="OnWindowSizeChanged"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="NavigationItemTemplate">
            <Button Style="{StaticResource NavigationButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    ToolTip="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Symbol"
                               FontSize="17" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontSize="14" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="152" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#E0E2DE"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,22,16,18">
                    <TextBlock Text="Diary of Mine"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="您的个人日程本"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MainNavigation}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,8,0,12">
                    <ItemsControl ItemsSource="{Binding FooterNavigation}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}" />
                    <TextBlock Text="{Binding EnvironmentLabel}"
                               Margin="20,9,20,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E9EAE7" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding CurrentPageTitle}"
                           Margin="28,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold" />
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
